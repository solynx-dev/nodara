# ---------------------------------------------------------------------------
# Nodara configuration. Copy to .env and adjust. See docs/configuration.md.
# ---------------------------------------------------------------------------

# Public URL people use to reach Nodara (no trailing slash). Must be HTTPS in
# production — browsers only allow geolocation, push and passkeys on secure origins.
PUBLIC_URL=https://nodara.example.com
# Used by the optional Caddy profile to obtain a certificate.
NODARA_DOMAIN=nodara.example.com

# Generate with:  openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-too

# Set to true when running behind a reverse proxy (Caddy, nginx, Traefik).
TRUST_PROXY=true

INSTANCE_NAME=Nodara
# open | invite | closed   (admins can change this later in the UI)
REGISTRATION_POLICY=invite
# Optional: require this token on the first-run setup screen.
SETUP_TOKEN=

# Optional email (verification, password reset). Without it, links are written to the server log.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM=Nodara <nodara@example.com>
REQUIRE_EMAIL_VERIFICATION=false

# Optional reverse geocoding / address search (any Nominatim-compatible server).
# Public OSM Nominatim is fine for a family instance within its usage policy:
#   https://operations.osmfoundation.org/policies/nominatim/
# GEOCODER_URL=https://nominatim.openstreetmap.org/
GEOCODER_URL=

# Optional: JSON array of map styles [{"id","name","url","dark"}]. Defaults to OpenFreeMap.
# MAP_STYLES=[{"id":"mine","name":"My tiles","url":"https://tiles.example.com/style.json","dark":false}]

# Web push keys are generated automatically on first start. Set these to pin them.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Days of location history to keep by default. 0 = forever.
DEFAULT_RETENTION_DAYS=0

LOG_LEVEL=info
