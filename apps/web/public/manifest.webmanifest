{
  "name": "Nodara",
  "short_name": "Nodara",
  "description": "Self-hosted location sharing for families and friends. Your people. Your places. Your data.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0C0E12",
  "theme_color": "#0C0E12",
  "categories": ["lifestyle", "navigation", "social"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Map", "url": "/map", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "History", "url": "/history", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
